{
  "name": "subwallet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "prisma:migrate": "npm --workspace apps/api run prisma:migrate",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:studio": "npm --workspace apps/api run prisma:studio"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@10.8.0"
}
