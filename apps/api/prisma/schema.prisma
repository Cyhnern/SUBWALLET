generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUM TANIMLARI
// ============================================

enum BillingCycle {
  weekly
  monthly
  quarterly
  yearly
  custom
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  trial
  expired
}

enum PaymentMethod {
  credit_card
  debit_card
  paypal
  bank_transfer
  crypto
  other
}

enum SharedAccountRole {
  owner
  admin
  member
}

enum SplitType {
  equal
  percentage
  fixed_amount
}

enum NotificationChannel {
  push
  email
  sms
}

// ============================================
// KULLANICILAR
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  fullName          String    @map("full_name")
  avatarUrl         String?   @map("avatar_url")
  baseCurrency      String    @default("USD") @map("base_currency") @db.Char(3)
  timezone          String    @default("UTC")
  oauthProvider     String?   @map("oauth_provider")
  oauthProviderId   String?   @map("oauth_provider_id")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  verificationToken String?   @map("verification_token")
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")
  pushToken         String?   @map("push_token")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  categories             Category[]
  subscriptions          Subscription[]
  ownedSharedAccounts    SharedAccount[]        @relation("SharedAccountOwner")
  sharedAccountMemberships SharedAccountMember[]
  costSplits             CostSplit[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
  refreshTokens          RefreshToken[]

  @@unique([oauthProvider, oauthProviderId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================
// KATEGORİLER
// ============================================

model Category {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id") // NULL = sistem geneli
  name      String
  icon      String?
  colorHex  String?  @map("color_hex") @db.Char(7)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  user                 User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions        Subscription[]
  defaultForProviders  ServiceProvider[]

  @@unique([userId, name])
  @@map("categories")
}

// ============================================
// SERVİS KATALOĞU
// ============================================

model ServiceProvider {
  id                 String   @id @default(uuid())
  name               String   @unique
  logoUrl            String?  @map("logo_url")
  defaultCategoryId  String?  @map("default_category_id")
  websiteUrl         String?  @map("website_url")
  createdAt          DateTime @default(now()) @map("created_at")

  defaultCategory Category?      @relation(fields: [defaultCategoryId], references: [id])
  subscriptions   Subscription[]

  @@map("service_providers")
}

// ============================================
// ORTAK HESAPLAR
// ============================================

model SharedAccount {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User                   @relation("SharedAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       SharedAccountMember[]
  subscriptions Subscription[]

  @@map("shared_accounts")
}

model SharedAccountMember {
  id              String            @id @default(uuid())
  sharedAccountId String            @map("shared_account_id")
  userId          String            @map("user_id")
  role            SharedAccountRole @default(member)
  joinedAt        DateTime          @default(now()) @map("joined_at")

  sharedAccount SharedAccount @relation(fields: [sharedAccountId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedAccountId, userId])
  @@map("shared_account_members")
}

// ============================================
// ABONELİKLER (çekirdek model)
// ============================================

model Subscription {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  sharedAccountId    String?             @map("shared_account_id")
  serviceProviderId  String?             @map("service_provider_id")
  categoryId         String?             @map("category_id")
  customName         String?             @map("custom_name")
  price              Decimal             @db.Decimal(12, 2)
  currency           String              @default("USD") @db.Char(3)
  billingCycle       BillingCycle        @default(monthly) @map("billing_cycle")
  customCycleDays    Int?                @map("custom_cycle_days")
  paymentMethod      PaymentMethod?      @map("payment_method")
  status             SubscriptionStatus  @default(active)
  startDate          DateTime            @map("start_date") @db.Date
  nextBillingDate    DateTime            @map("next_billing_date") @db.Date
  trialEndDate       DateTime?           @map("trial_end_date") @db.Date
  cancelledAt        DateTime?           @map("cancelled_at")
  lastUsedAt         DateTime?           @map("last_used_at")
  invoiceUrl         String?             @map("invoice_url")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedAccount   SharedAccount?   @relation(fields: [sharedAccountId], references: [id], onDelete: SetNull)
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  history         SubscriptionHistory[]
  costSplits      CostSplit[]
  notificationLogs NotificationLog[]

  @@index([userId, status])
  @@index([nextBillingDate])
  @@index([sharedAccountId])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  changedField   String   @map("changed_field")
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  changedAt      DateTime @default(now()) @map("changed_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_history")
}

// ============================================
// MALİYET PAYLAŞIMI
// ============================================

model CostSplit {
  id                  String    @id @default(uuid())
  subscriptionId      String    @map("subscription_id")
  userId              String    @map("user_id")
  splitType           SplitType @default(equal) @map("split_type")
  splitValue          Decimal?  @map("split_value") @db.Decimal(12, 4)
  computedAmount      Decimal   @map("computed_amount") @db.Decimal(12, 2)
  isSettled           Boolean   @default(false) @map("is_settled")
  settledAt           DateTime? @map("settled_at")
  billingPeriodStart  DateTime  @map("billing_period_start") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, userId, billingPeriodStart])
  @@index([userId, isSettled])
  @@map("cost_splits")
}

// ============================================
// BİLDİRİMLER
// ============================================

model NotificationPreference {
  id                    String                 @id @default(uuid())
  userId                String                 @unique @map("user_id")
  channels              NotificationChannel[]  @default([push])
  daysBeforeRenewal     Int[]                  @default([3, 1]) @map("days_before_renewal")
  zombieAlertsEnabled   Boolean                @default(true) @map("zombie_alerts_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationLog {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  subscriptionId String?             @map("subscription_id")
  channel        NotificationChannel
  type           String
  sentAt         DateTime            @default(now()) @map("sent_at")
  status         String              @default("sent")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt(sort: Desc)])
  @@map("notification_log")
}
