# --- Uygulama ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Veritabanı ---
DATABASE_URL="postgresql://subwallet:subwallet_dev_password@localhost:5433/subwallet?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=degistir_bu_cok_gizli_bir_deger
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Google callback'inin başarılı girişten sonra mobil uygulamaya yönlendirdiği deep link
MOBILE_OAUTH_REDIRECT_URL=subwallet://oauth

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Bildirim Sağlayıcıları ---
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=

# --- Gözlemlenebilirlik ---
SENTRY_DSN=
